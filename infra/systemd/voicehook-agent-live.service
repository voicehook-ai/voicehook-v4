[Unit]
Description=voicehook.ai Gemini-Live-Testworker `voice-ai-live` (kein HTTP; nur Räume mit ?live=<VOICEHOOK_LIVE_KEY>)
After=network.target voicehook-agent.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/voicehook
EnvironmentFile=/opt/voicehook/.env
Environment=VOICEHOOK_PIPELINE=live
Environment=VOICEHOOK_AGENT_NAME=voice-ai-live
Environment=VOICEHOOK_HTTP_DISABLED=1
ExecStart=/opt/voicehook/.venv/bin/python -m agent start
Restart=on-failure
RestartSec=5
StandardOutput=append:/var/log/voicehook-agent-live.log
StandardError=append:/var/log/voicehook-agent-live.log

[Install]
WantedBy=multi-user.target
