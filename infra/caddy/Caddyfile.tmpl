{
  email ops@voicehook.ai
}

__SITE_MAIN__ {
  @enc not path /api/bridge/events  # SSE der Agent-Brücke nie komprimieren (Puffer); reverse_proxy flusht text/event-stream sofort
  encode @enc zstd gzip
  log {
    output file /var/log/caddy/access.log
    format filter {  # Geheimnisse nie im Klartext ins Log; Altlog: deploy/redact_caddy_log.py
      wrap console
      fields {
        request>headers>X-Wallet-Token replace REDACTED
        request>headers>Authorization replace REDACTED
        request>headers>Cookie replace REDACTED
        resp_headers>Set-Cookie replace REDACTED
        request>headers>Referer regexp "([?&](token|nonce|invite|session_id|r|code|state)=)[^&#]*" "${1}REDACTED"
        resp_headers>Location regexp "([?&](token|nonce|invite|session_id|r|code|state)=)[^&#]*" "${1}REDACTED"
        request>uri query {
          replace token REDACTED
          replace nonce REDACTED
          replace invite REDACTED
          replace session_id REDACTED
          replace r REDACTED
          replace code REDACTED
          replace state REDACTED
        }
      }
    }
  }
  @api path /api/* /healthz /status
  handle @api {
    # Kein trusted_proxies: Caddy verwirft eingehende X-Forwarded-For-Werte und setzt
    # die echte Client-IP. Die API nimmt das LETZTE Element (server._client_ip). Kommt
    # je ein CDN davor, hier trusted_proxies <CDN-Netze> setzen, sonst zählt die CDN-IP.
    reverse_proxy 127.0.0.1:7400 {
      lb_try_duration 10s  # Deploy: voicehook-http startet neu (~1-2 s), Caddy wiederholt statt 502
    }
  }
  handle {
    root * /var/www/voicehook
    @footer path /impressum /datenschutz /setup  # Footer-Seiten (PR #83)
    rewrite @footer {path}.html
    rewrite /security /.well-known/security.txt
    rewrite /aufladen /aufladen.html  # Guthaben aufladen (Stripe Checkout)
    rewrite /login /login.html  # Anmelden (Google, GitHub, E-Mail-Link)
    try_files {path} /voice.html
    header Cache-Control "no-cache"  # nach jedem Deploy sofort neue Seite (ETag-Revalidierung)
    file_server
  }
}

__SITE_RTC__ {
  reverse_proxy 127.0.0.1:7880
}
